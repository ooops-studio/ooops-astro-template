# Core CMS/site
OOOPS_CMS_API_BASE_URL=http://cms.localhost:4175/api/cms/v1
OOOPS_CMS_API_TOKEN=
# Optional real CMS integration test. It only reads homepage, posts and the bootstrap newsletter form.
# pnpm test:cms:integration
# Set both below only when you intentionally want the integration test to create a disposable newsletter submission.
# OOOPS_CMS_INTEGRATION_FORM_SHARE_TOKEN=
# OOOPS_CMS_INTEGRATION_FORM_TEST_EMAIL=
PUBLIC_SITE_URL=http://localhost:4321

# Analytics consent
PUBLIC_CMS_ANALYTICS_SCRIPT_URL=
PUBLIC_CMS_ANALYTICS_WEBSITE_ID=
# Optional browser telemetry is always consent-gated. There is no bypass flag.
PUBLIC_CMS_ANALYTICS_RESPECT_DNT=true
# The connected-site CMS/Umami service retains raw analytics for 90 days.
PUBLIC_CMS_ANALYTICS_RETENTION=90 days
PUBLIC_CMS_ANALYTICS_PERFORMANCE_ENABLED=false
PUBLIC_CMS_ANALYTICS_REPLAY_ENABLED=false
PUBLIC_CMS_ANALYTICS_REPLAY_SCRIPT_URL=
PUBLIC_CMS_ANALYTICS_REPLAY_SAMPLE_RATE=0.05
PUBLIC_CMS_ANALYTICS_REPLAY_MASK_LEVEL=moderate
PUBLIC_CMS_ANALYTICS_REPLAY_MAX_DURATION_MS=600000
PUBLIC_CMS_ANALYTICS_REPLAY_BLOCK_SELECTOR=[data-private], [data-sensitive]
PUBLIC_CMS_ANALYTICS_EXCLUDED_PATHS=/preview
PUBLIC_CMS_ANALYTICS_INTERNAL_REFERRER_DOMAINS=

# CMS draft preview (server / Cloudflare Worker only)
# The API base URL must end with /api/cms/v1. The token needs cms:content:read.
OOOPS_CMS_API_BASE_URL=http://cms.localhost:4175/api/cms/v1
OOOPS_CMS_API_TOKEN=
# Generate a long random value. It encrypts the short-lived preview session cookie.
OOOPS_CMS_PREVIEW_SESSION_SECRET=

# Cloudflare rebuild webhook
CLOUDFLARE_PAGES_DEPLOY_HOOK_URL=
CMS_WEBHOOK_SECRET=

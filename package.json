{
  "name": "ooops-astro-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ooops-studio/ooops-astro-template.git"
  },
  "homepage": "https://github.com/ooops-studio/ooops-astro-template#readme",
  "bugs": {
    "url": "https://github.com/ooops-studio/ooops-astro-template/issues"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm typecheck && astro build",
    "check": "pnpm typecheck && pnpm check:template",
    "check:content-health": "node scripts/check-content-health.mjs",
    "check:openapi": "node scripts/check-openapi-contract.mjs",
    "check:template": "node scripts/check-cms-api-contracts.mjs",
    "generate:editor": "node scripts/generate-editor.mjs",
    "check:editor": "node scripts/check-editor.mjs",
    "check:cms-api-contracts": "node scripts/check-cms-api-contracts.mjs",
    "example:newsletter-submit": "tsx examples/newsletter-submit.ts",
    "example:read-content": "tsx examples/read-content.ts",
    "lint": "eslint . --cache --cache-location .cache/eslint",
    "preview": "astro preview",
    "setup:client": "node scripts/setup-client-project.mjs",
    "setup:module": "node scripts/setup-module.mjs",
    "cms:bootstrap": "node scripts/cms-bootstrap.mjs",
    "test:i18n": "tsx scripts/test-i18n-helpers.mjs",
    "test:newsletter": "node scripts/test-newsletter-module.mjs",
    "test:modules": "node scripts/test-template-modules.mjs",
    "test:cms-rebuild": "tsx --test tests/unit/cms-rebuild-worker.test.ts",
    "test:cms:integration": "node scripts/test-cms-content-forms-integration.mjs",
    "test:e2e": "pnpm build && playwright test",
    "test:analytics:e2e": "PUBLIC_CMS_ANALYTICS_SCRIPT_URL=http://127.0.0.1:4402/umami.js PUBLIC_CMS_ANALYTICS_WEBSITE_ID=astro-template-e2e PUBLIC_CMS_ANALYTICS_PERFORMANCE_ENABLED=true PUBLIC_CMS_ANALYTICS_RESPECT_DNT=true pnpm build && playwright test --config playwright.analytics.config.ts",
    "test:analytics:consumer": "node scripts/test-published-analytics-consumer.mjs",
    "test:editor:e2e": "playwright test --config playwright.editor.config.ts",
    "test:preview:e2e": "pnpm build && playwright test --config playwright.preview.config.ts",
    "typecheck": "astro check",
    "types:cloudflare": "wrangler types",
    "validate": "pnpm lint && pnpm validate:env && pnpm check:editor && pnpm check && pnpm check:openapi && pnpm check:content-health && pnpm test:i18n && pnpm test:newsletter && pnpm test:modules && pnpm test:cms-rebuild && pnpm build",
    "validate:env": "node scripts/validate-env.mjs"
  },
  "dependencies": {
    "@astrojs/svelte": "^9.0.1",
    "@lucide/astro": "^1.28.0",
    "@ooopsstudio/accessibility": "^0.2.0",
    "@ooopsstudio/accessibility-astro": "^0.2.0",
    "@ooopsstudio/analytics-consent": "^0.3.0",
    "@ooopsstudio/analytics-consent-astro": "^0.3.0",
    "@ooopsstudio/cms-api": "^0.2.0",
    "@ooopsstudio/cms-astro": "^0.2.1",
    "@ooopsstudio/cms-cloudflare": "^0.3.1",
    "@ooopsstudio/ui-astro": "^0.2.0",
    "@ooopsstudio/ui-primitives": "^0.2.0",
    "astro": "^7.1.4",
    "svelte": "^5.56.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "14.1.0",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^16.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "wrangler": "4.120.1"
  }
}

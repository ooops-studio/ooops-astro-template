{
  "id": "rebuildWebhook",
  "label": "Cloudflare rebuild webhook",
  "defaultEnabled": true,
  "readme": "optional/cloudflare-rebuild/README.md",
  "deps": ["@ooopsstudio/cms-cloudflare"],
  "env": [
    { "name": "CLOUDFLARE_PAGES_DEPLOY_HOOK_URL", "required": true },
    { "name": "CMS_WEBHOOK_SECRET", "required": true }
  ],
  "files": [
    { "from": "optional/cloudflare-rebuild/functions/api/cms/rebuild.ts", "to": "functions/api/cms/rebuild.ts" }
  ],
  "cleanupTargets": ["functions/api/cms/rebuild.ts"],
	"validationChecks": ["cms-webhook-signature"],
	"cloudflare": "Set CLOUDFLARE_PAGES_DEPLOY_HOOK_URL and CMS_WEBHOOK_SECRET in Pages env vars."
}

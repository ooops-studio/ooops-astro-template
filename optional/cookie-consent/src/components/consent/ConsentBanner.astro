<aside class="consent-banner" aria-label="Cookie consent">
  <p>This site can use privacy-aware analytics.</p>
  <div class="consent-actions">
    <button type="button" data-consent-accept>Accept</button>
    <button type="button" data-consent-reject>Reject</button>
  </div>
</aside>

<style>
  .consent-banner {
    position: fixed;
    inset-inline: var(--space-4);
    bottom: var(--space-4);
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .consent-banner p {
    margin: 0;
  }

  .consent-actions {
    display: flex;
    gap: var(--space-2);
  }
</style>

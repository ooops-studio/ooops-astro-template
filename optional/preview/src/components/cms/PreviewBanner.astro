---
type Props = {
  active?: boolean;
  exitPath?: string;
};

const { active = false, exitPath = '/' } = Astro.props;
const exitHref = `/preview/content/exit?redirect=${encodeURIComponent(exitPath)}`;
---

<aside class="preview-banner" role="status" data-cms-preview-banner data-server-preview={active ? 'true' : undefined} hidden={!active}>
  <span>Preview mode</span>
  <a href={exitHref} data-cms-preview-exit>Exit preview</a>
</aside>

<style>
  .preview-banner {
    position: fixed;
    inset-inline: var(--space-4);
    top: var(--space-4);
    z-index: 80;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    width: fit-content;
    margin-inline: auto;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
    color: var(--color-text);
    font-size: var(--font-size-sm);
  }

  .preview-banner[hidden] {
    display: none;
  }

  .preview-banner a {
    color: var(--color-accent);
    font-weight: 700;
  }
</style>

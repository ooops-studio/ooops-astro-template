---
import PreviewContent from '../../../../components/stage/PreviewContent.astro';
import { previewContent } from '../../../../lib/cms-preview/content';
import { preparePreview, publicPreviewPath } from '../../../../lib/cms-preview/client';
import BaseLayout from '../../../../layouts/BaseLayout.astro';

export const prerender = false;
const apiId = Astro.params.apiId?.trim() || '';
const result = await preparePreview({ apiId, kind: 'single', request: Astro.request, previewToken: Astro.url.searchParams.get('preview') });
if (result.redirect && result.setCookie) return new Response(null, { status: 303, headers: { location: result.redirect, 'set-cookie': result.setCookie, 'cache-control': 'private, no-store', 'referrer-policy': 'no-referrer' } });
Astro.response.headers.set('cache-control', 'private, no-store');
Astro.response.headers.set('referrer-policy', 'no-referrer');
Astro.response.headers.set('x-robots-tag', 'noindex, nofollow');
if (!result.payload?.data) return new Response('Preview not found.', { status: 404 });
const content = previewContent(result.payload.data, Astro.url.pathname, apiId);
---

<BaseLayout seo={content.seo} preview={true} previewExitPath={publicPreviewPath({ apiId, kind: 'single' })}>
  <PreviewContent content={content} />
</BaseLayout>

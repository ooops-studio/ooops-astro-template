{
  "id": "preview",
  "label": "CMS draft preview",
  "defaultEnabled": true,
  "readme": "optional/preview/README.md",
  "deps": ["@astrojs/cloudflare"],
  "env": [
    { "name": "OOOPS_CMS_API_BASE_URL", "required": true, "example": "https://cms.example.com/api/cms/v1" },
    { "name": "OOOPS_CMS_API_TOKEN", "required": true },
    { "name": "OOOPS_CMS_PREVIEW_SESSION_SECRET", "required": true }
  ],
  "files": [
    { "from": "optional/preview/src/components/stage/PreviewContent.astro", "to": "src/components/stage/PreviewContent.astro" },
    { "from": "optional/preview/src/lib/cms-preview/client.ts", "to": "src/lib/cms-preview/client.ts" },
    { "from": "optional/preview/src/lib/cms-preview/content.ts", "to": "src/lib/cms-preview/content.ts" },
    { "from": "optional/preview/src/lib/cms-preview/session.ts", "to": "src/lib/cms-preview/session.ts" },
    { "from": "optional/preview/src/pages/preview/content/exit.ts", "to": "src/pages/preview/content/exit.ts" },
    { "from": "optional/preview/src/pages/preview/content/singles/[apiId].astro", "to": "src/pages/preview/content/singles/[apiId].astro" },
    { "from": "optional/preview/src/pages/preview/content/collections/[apiId]/[slug].astro", "to": "src/pages/preview/content/collections/[apiId]/[slug].astro" }
  ],
  "cleanupTargets": [
    "src/components/stage/PreviewContent.astro",
    "src/lib/cms-preview",
    "src/pages/preview/content"
  ],
  "validationChecks": ["cms-preview-e2e"],
  "cloudflare": "Set OOOPS_CMS_API_BASE_URL, OOOPS_CMS_API_TOKEN and OOOPS_CMS_PREVIEW_SESSION_SECRET as Worker-only variables."
}

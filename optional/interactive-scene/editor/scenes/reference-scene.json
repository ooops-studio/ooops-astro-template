{
  "schemaVersion": 2,
  "id": "reference-scene",
  "label": "Reference scene",
  "category": "interactive",
  "owner": "ooops-astro-template",
  "internals": "locked",
  "adapters": {
    "astro": "@ooopsstudio/scene-astro/InteractiveScene.astro",
    "runtime": "@ooopsstudio/scene-gpu"
  },
  "backend": "auto",
  "controls": [
    {
      "id": "intensity",
      "label": "Intensity",
      "schema": {"kind": "number", "min": 0.2, "max": 3, "step": 0.05},
      "default": 1,
      "editable": true,
      "control": "range"
    },
    {
      "id": "pointerStrength",
      "label": "Pointer strength",
      "schema": {"kind": "number", "min": 0, "max": 2, "step": 0.1},
      "default": 0.8,
      "editable": true,
      "control": "range"
    },
    {
      "id": "distortion",
      "label": "Distortion",
      "schema": {"kind": "number", "min": 0, "max": 1.5, "step": 0.05},
      "default": 0.5,
      "editable": true,
      "control": "range"
    },
    {
      "id": "primaryColor",
      "label": "Primary color",
      "schema": {"kind": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
      "default": "#cd0208",
      "editable": true,
      "control": "color"
    },
    {
      "id": "secondaryColor",
      "label": "Secondary color",
      "schema": {"kind": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
      "default": "#f1efef",
      "editable": true,
      "control": "color"
    }
  ],
  "assets": [],
  "inputs": ["pointer", "velocity", "time", "viewport"],
  "quality": {"default": "auto", "allowed": ["low", "auto", "high"]},
  "fallbacks": {
    "poster": "public/assets/scenes/reference-poster.png",
    "description": "A red distortion field follows pointer movement across a pale surface.",
    "reducedMotion": "poster",
    "contextLoss": "poster"
  }
}

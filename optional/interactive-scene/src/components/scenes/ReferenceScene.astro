---
import '@ooopsstudio/scene-astro/base.css';
import InteractiveScene from '@ooopsstudio/scene-astro/InteractiveScene.astro';
import EditorBoundary from '../editor/EditorBoundary.astro';

type Props = {
  editorId?: string;
  backend?: 'auto' | 'webgl2';
  intensity?: number;
  rotationSpeed?: number;
  pointerStrength?: number;
  distortion?: number;
  primaryColor?: string;
  secondaryColor?: string;
  model?: string;
  quality?: 'low' | 'auto' | 'high';
  poster?: string;
  description?: string;
};

const {
  editorId,
  backend = 'auto',
  intensity = 1,
  rotationSpeed = 0.35,
  pointerStrength = 0.8,
  distortion = 0.5,
  primaryColor = '#5de2c2',
  secondaryColor = '#ff6f61',
  model = '/assets/scenes/reference.glb',
  quality = 'auto',
  poster = '/assets/scenes/reference-poster.png',
  description = 'A faceted geometric object rotates and changes color with pointer movement.'
} = Astro.props;
const scene = backend === 'webgl2' ? 'reference-scene-webgl2' : 'reference-scene';
---

<EditorBoundary editorId={editorId} manifestId="reference-scene">
  <InteractiveScene
    scene={scene}
    config={{intensity, rotationSpeed, pointerStrength, distortion, primaryColor, secondaryColor, model}}
    {quality}
    {poster}
    {description}
    aspectRatio="16 / 9"
  />
</EditorBoundary>

<script>
  import '../../scenes';
</script>

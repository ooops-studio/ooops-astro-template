{
  "id": "interactiveScene",
  "label": "Interactive WebGPU scene",
  "defaultEnabled": false,
  "readme": "optional/interactive-scene/README.md",
  "deps": [
    "@ooopsstudio/scene-core",
    "@ooopsstudio/scene-gpu",
    "@ooopsstudio/scene-astro"
  ],
  "dependencies": {
    "@ooopsstudio/scene-core": "^0.1.0",
    "@ooopsstudio/scene-gpu": "^0.1.0",
    "@ooopsstudio/scene-astro": "^0.1.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0"
  },
  "localOverrides": {
    "@ooopsstudio/scene-core": "file:../ooops-ui/packages/scene-core",
    "@ooopsstudio/scene-gpu": "file:../ooops-ui/packages/scene-gpu",
    "@ooopsstudio/scene-astro": "file:../ooops-ui/packages/scene-astro"
  },
  "env": [],
  "files": [
    {"from": "optional/interactive-scene/src/scenes/index.ts", "to": "src/scenes/index.ts"},
    {"from": "optional/interactive-scene/src/scenes/reference-scene.ts", "to": "src/scenes/reference-scene.ts"},
    {"from": "optional/interactive-scene/src/scenes/reference-scene.runtime.json", "to": "src/scenes/reference-scene.runtime.json"},
    {"from": "optional/interactive-scene/src/components/scenes/ReferenceScene.astro", "to": "src/components/scenes/ReferenceScene.astro"},
    {"from": "optional/interactive-scene/src/pages/interactive-scene.astro", "to": "src/pages/interactive-scene.astro"},
    {"from": "optional/interactive-scene/src/pages/interactive-scene-webgl2.astro", "to": "src/pages/interactive-scene-webgl2.astro"},
    {"from": "optional/interactive-scene/tests/e2e/interactive-scene.spec.ts", "to": "tests/e2e/interactive-scene.spec.ts"},
    {"from": "optional/interactive-scene/editor/scenes/reference-scene.json", "to": "editor/scenes/reference-scene.json"},
    {"from": "optional/interactive-scene/editor/extensions/reference-scene.json", "to": "editor/extensions/reference-scene.json"},
    {"from": "optional/interactive-scene/public/assets/scenes/reference-poster.png", "to": "public/assets/scenes/reference-poster.png"}
  ],
  "cleanupTargets": [
    "src/scenes",
    "src/components/scenes",
    "src/pages/interactive-scene.astro",
    "src/pages/interactive-scene-webgl2.astro",
    "tests/e2e/interactive-scene.spec.ts",
    "editor/scenes",
    "editor/extensions",
    "public/assets/scenes"
  ],
  "validationChecks": ["interactive-scene-registry", "interactive-scene-render"],
  "editor": {
    "scenes": [
      {
        "id": "reference-scene",
        "source": "src/scenes/reference-scene.ts",
        "manifest": "editor/scenes/reference-scene.json",
        "manifestId": "reference-scene",
        "editorIdProp": "editorId",
        "behavior": "template"
      }
    ],
    "extensions": [
      {
        "id": "reference-scene-controls",
        "manifest": "editor/extensions/reference-scene.json",
        "manifestId": "reference-scene-controls",
        "behavior": "template"
      }
    ]
  }
}

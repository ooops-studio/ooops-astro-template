{
  "formatVersion": "cms-template-bundle/v1",
  "name": "CMS Astro Site Template Starter",
  "contentTypes": [
    {
      "kind": "single",
      "apiId": "homepage",
      "displayName": "Homepage",
      "description": "Homepage copy and SEO fields for the Astro template.",
      "publicMode": "public_readable",
      "reviewWorkflowMode": "disabled",
      "includeSeoFields": false,
      "fields": [
        {
          "apiId": "title",
          "displayName": "Page title",
          "kind": "text",
          "isRequired": true
        },
        {
          "apiId": "heading",
          "displayName": "Heading",
          "kind": "text",
          "isRequired": true
        },
        {
          "apiId": "description",
          "displayName": "Description",
          "kind": "rich_text",
          "isRequired": true
        },
        {
          "apiId": "proof-text",
          "displayName": "Publish proof text",
          "kind": "text",
          "isRequired": true
        },
        {
          "apiId": "cta-label",
          "displayName": "CTA label",
          "kind": "text",
          "isRequired": true
        },
        {
          "apiId": "cta-url",
          "displayName": "CTA URL",
          "kind": "text",
          "isRequired": true
        },
        {
          "apiId": "seo-title",
          "displayName": "SEO title",
          "kind": "text"
        },
        {
          "apiId": "seo-description",
          "displayName": "SEO description",
          "kind": "text"
        },
        {
          "apiId": "canonical-path-override",
          "displayName": "Canonical path override",
          "kind": "text"
        },
        {
          "apiId": "robots-index",
          "displayName": "Robots index",
          "kind": "boolean"
        },
        {
          "apiId": "robots-follow",
          "displayName": "Robots follow",
          "kind": "boolean"
        },
        {
          "apiId": "google-site-verification",
          "displayName": "Google site verification",
          "kind": "text"
        },
        {
          "apiId": "twitter-handle",
          "displayName": "Twitter handle",
          "kind": "text"
        }
      ]
    },
    {
      "kind": "collection",
      "apiId": "posts",
      "displayName": "Posts",
      "description": "Blog/news collection used by the included posts pages.",
      "publicMode": "public_readable",
      "reviewWorkflowMode": "disabled",
      "hasSlug": true,
      "taggable": true,
      "fields": [
        {
          "apiId": "title",
          "displayName": "Title",
          "kind": "text",
          "isRequired": true,
          "isSearchable": true
        },
        {
          "apiId": "slug",
          "displayName": "Slug",
          "kind": "slug",
          "isRequired": true,
          "isUnique": true,
          "isSortable": true
        },
        {
          "apiId": "excerpt",
          "displayName": "Excerpt",
          "kind": "text"
        },
        {
          "apiId": "hero-image",
          "displayName": "Hero image",
          "kind": "media"
        },
        {
          "apiId": "body",
          "displayName": "Body",
          "kind": "rich_text",
          "isRequired": true
        },
        {
          "apiId": "seo-title",
          "displayName": "SEO title",
          "kind": "text"
        },
        {
          "apiId": "seo-description",
          "displayName": "SEO description",
          "kind": "text"
        }
      ]
    }
  ],
  "singles": [
    {
      "apiId": "homepage",
      "publish": true,
      "payload": {
        "title": {
          "value": "Ooops CMS Astro Test",
          "localized": {}
        },
        "heading": {
          "value": "A real CMS-to-Astro publishing chain",
          "localized": {}
        },
        "description": {
          "value": "Published in Ooops CMS, signed at the rebuild endpoint, and deployed as static Astro output through Cloudflare Workers Builds.",
          "localized": {}
        },
        "proof-text": {
          "value": "CMS publish proof: initial release",
          "localized": {}
        },
        "cta-label": {
          "value": "Read the launch post",
          "localized": {}
        },
        "cta-url": {
          "value": "/posts/hello-from-cms",
          "localized": {}
        },
        "seo-title": {
          "value": "Ooops CMS Astro Publishing Test",
          "localized": {}
        },
        "seo-description": {
          "value": "A production-verified CMS to Astro SSG publishing chain on Cloudflare.",
          "localized": {}
        },
        "robots-index": {
          "value": true,
          "localized": {}
        },
        "robots-follow": {
          "value": true,
          "localized": {}
        }
      }
    }
  ],
  "collections": [
    {
      "apiId": "posts",
      "entries": [
        {
          "title": "Hello from CMS",
          "slug": "hello-from-cms",
          "publish": true,
          "payload": {
            "title": {
              "value": "Hello from CMS",
              "localized": {}
            },
            "excerpt": {
              "value": "How this production test connects Ooops CMS publishing to an Astro SSG deployment.",
              "localized": {}
            },
            "body": {
              "value": "This article is published from Ooops CMS and generated into the static Astro site by Cloudflare Workers Builds.",
              "localized": {}
            },
            "seo-title": {
              "value": "Hello from CMS",
              "localized": {}
            },
            "seo-description": {
              "value": "Production test article for the Ooops CMS and Astro publishing chain.",
              "localized": {}
            }
          }
        }
      ]
    }
  ],
  "forms": [
    {
      "key": "contact",
      "title": "Contact request",
      "description": "Collect contact requests from the public Astro site.",
      "navigationMode": "free",
      "publicShareEnabled": true,
      "thankYouTitle": "Message received",
      "thankYouMessage": "Thanks. Your message has been received.",
      "publish": true,
      "fields": [
        {
          "apiId": "name",
          "displayName": "Name",
          "kind": "text",
          "isRequired": true
        },
        {
          "apiId": "email",
          "displayName": "Email",
          "kind": "email",
          "isRequired": true
        },
        {
          "apiId": "message",
          "displayName": "Message",
          "kind": "long_text",
          "isRequired": true
        }
      ]
    }
  ],
  "webhooks": []
}

---
import { mediaSourceSet, resolveMediaRecord, mediaAlt, mediaIsDecorative, mediaUrl, normalizeAssetUrl, type PublicMediaMap } from '../../lib/cms/content-helpers';

type Props = {
  asset?: unknown;
  mediaMap?: PublicMediaMap;
  locale?: string;
  src?: string | null;
  alt?: string;
  fallbackSrc?: string;
  width?: number | string;
  height?: number | string;
  sizes?: string;
  srcset?: string;
  responsive?: boolean;
  priority?: boolean;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'sync' | 'auto';
  class?: string;
};

const {
  asset,
  mediaMap,
  locale = 'en',
  src,
  alt,
  fallbackSrc = '/assets/images/fallback-image.svg',
  width,
  height,
  sizes = '(min-width: 960px) 50vw, 100vw',
  srcset,
  responsive = true,
  priority = false,
  loading = 'lazy',
  decoding = 'async',
  class: className = ''
} = Astro.props;

const record = resolveMediaRecord(asset, mediaMap);
const resolvedSrc = normalizeAssetUrl(src || '') || mediaUrl(record) || fallbackSrc;
const resolvedAlt = alt ?? mediaAlt(record, '', undefined, locale);
const resolvedLoading = priority ? 'eager' : loading;
const resolvedFetchPriority = priority ? 'high' : undefined;
// Explicit sources remain authoritative and are never overridden by <source>.
const useVariants = responsive && !src && srcset === undefined;
const avif = useVariants ? mediaSourceSet(record, 'image/avif') : undefined;
const webp = useVariants ? mediaSourceSet(record, 'image/webp') : undefined;
const resolvedWidth = width ?? (typeof record.width === 'number' ? record.width : undefined);
const resolvedHeight = height ?? (typeof record.height === 'number' ? record.height : undefined);

if (import.meta.env.DEV && asset && !resolvedAlt && !mediaIsDecorative(record)) {
  console.warn('[CmsImage] Missing alt text for CMS media asset.', asset);
}
---

<picture>
{avif && <source type="image/avif" srcset={avif} sizes={sizes} />}
{webp && <source type="image/webp" srcset={webp} sizes={sizes} />}
<img
  class:list={['cms-image', className]}
  src={resolvedSrc}
  alt={resolvedAlt}
  srcset={srcset}
  width={resolvedWidth}
  height={resolvedHeight}
  sizes={sizes}
  loading={resolvedLoading}
  fetchpriority={resolvedFetchPriority}
  decoding={decoding}
/>
</picture>

<style>
  .cms-image {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: var(--cms-image-radius, var(--radius-md));
    object-fit: var(--cms-image-fit, cover);
    background: var(--color-surface-muted);
  }
</style>

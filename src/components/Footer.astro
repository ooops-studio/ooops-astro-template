---
type Props = {
  text?: string;
};

const { text = 'Powered by Ooops CMS and Astro.' } = Astro.props;
const analyticsConfigured = Boolean(
  import.meta.env.PUBLIC_CMS_ANALYTICS_SCRIPT_URL && import.meta.env.PUBLIC_CMS_ANALYTICS_WEBSITE_ID
);
const showAnalyticsPreferences = analyticsConfigured;
---

<footer class="site-footer">
  <span>{text}</span>
  <a href="/privacy">Privacy notice</a>
  {
    showAnalyticsPreferences ? (
      <button data-ooops-consent-preferences type="button">Manage analytics choices</button>
    ) : null
  }
</footer>

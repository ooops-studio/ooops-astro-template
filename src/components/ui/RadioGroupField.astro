---
import RadioGroup from '@ooopsstudio/ui-astro/RadioGroup.astro';
import EditorBoundary from '../editor/EditorBoundary.astro';
type Props = Parameters<typeof RadioGroup>[0] & { editorId?: string };
const { editorId, ...props } = Astro.props as Props;
---
<EditorBoundary editorId={editorId} manifestId="radio-group"><RadioGroup {...props}><slot /></RadioGroup></EditorBoundary>

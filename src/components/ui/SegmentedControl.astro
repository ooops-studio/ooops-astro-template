---
import SegmentedControl from '@ooopsstudio/ui-astro/SegmentedControl.astro';
import EditorBoundary from '../editor/EditorBoundary.astro';
type Props = Parameters<typeof SegmentedControl>[0] & { editorId?: string };
const { editorId, ...props } = Astro.props as Props;
---
<EditorBoundary editorId={editorId} manifestId="segmented-control"><SegmentedControl {...props}><slot /></SegmentedControl></EditorBoundary>

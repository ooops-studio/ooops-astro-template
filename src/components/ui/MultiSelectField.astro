---
import MultiSelect from '@ooopsstudio/ui-astro/MultiSelect.astro';
import EditorBoundary from '../editor/EditorBoundary.astro';
type Props = Parameters<typeof MultiSelect>[0] & { editorId?: string };
const { editorId, ...props } = Astro.props as Props;
---
<EditorBoundary editorId={editorId} manifestId="multi-select"><MultiSelect {...props}><slot /></MultiSelect></EditorBoundary>

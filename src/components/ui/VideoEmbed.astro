---
import EditorBoundary from '../editor/EditorBoundary.astro';
type Props = { url: string; title: string; aspectRatio?: string; class?: string; editorId?: string; editorSource?: string };
const { url, title, aspectRatio = '16 / 9', class: className, editorId, editorSource } = Astro.props;
const parsed = new URL(url);
let src: string;
if (['youtube.com', 'www.youtube.com', 'youtu.be'].includes(parsed.hostname)) {
  const id = parsed.hostname === 'youtu.be' ? parsed.pathname.slice(1) : parsed.searchParams.get('v') ?? parsed.pathname.split('/').filter(Boolean).at(-1) ?? '';
  if (!/^[A-Za-z0-9_-]{6,20}$/.test(id)) throw new Error('Invalid YouTube video URL.');
  src = `https://www.youtube-nocookie.com/embed/${id}`;
} else if (['vimeo.com', 'www.vimeo.com', 'player.vimeo.com'].includes(parsed.hostname)) {
  const id = parsed.pathname.split('/').filter(Boolean).at(-1) ?? '';
  if (!/^\d{5,15}$/.test(id)) throw new Error('Invalid Vimeo video URL.');
  src = `https://player.vimeo.com/video/${id}`;
} else throw new Error('Only YouTube and Vimeo embeds are supported.');
---
<EditorBoundary editorId={editorId} manifestId="video-embed" sourceFile={editorSource}><div class:list={['ui-video-embed', className]} style={`aspect-ratio:${aspectRatio}`} data-part="root"><iframe {src} {title} loading="lazy" allow="accelerometer; autoplay; encrypted-media; picture-in-picture" allowfullscreen data-part="frame"></iframe></div></EditorBoundary>
<style>.ui-video-embed iframe{display:block;width:100%;height:100%;border:0}</style>

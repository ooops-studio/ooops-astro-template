---
import CookieBanner from '@ooopsstudio/analytics-consent-astro/CookieBanner.astro';
import type { OptionalConsentCategory } from '@ooopsstudio/analytics-consent';

const truthy = (value: string | undefined, fallback = false) => {
  if (value === undefined || value === '') return fallback;
  return ['1', 'true', 'yes', 'on'].includes(value.toLowerCase());
};

const analyticsConfigured = Boolean(
  import.meta.env.PUBLIC_STAGE_ANALYTICS_SCRIPT_URL && import.meta.env.PUBLIC_STAGE_ANALYTICS_WEBSITE_ID
);
const performanceEnabled = truthy(import.meta.env.PUBLIC_STAGE_ANALYTICS_PERFORMANCE_ENABLED, false);
const replayEnabled = truthy(import.meta.env.PUBLIC_STAGE_ANALYTICS_REPLAY_ENABLED, false);
const enabled = analyticsConfigured;
const categories: OptionalConsentCategory[] = [
  ...(performanceEnabled ? ['performance' as const] : []),
  ...(replayEnabled ? ['replay' as const] : [])
];
const preferencesConfigId = 'stage-analytics-preferences-config';
const preferencesConfig = JSON.stringify({
  privacyHref: '/privacy',
  consentDurationDays: 180,
  noticeVersion: 'consent-v3',
  policyVersion: 'privacy-v1',
  categories,
  className: 'stage-consent'
}).replace(/[<>&\u2028\u2029]/g, (character) => ({
  '<': '\\u003c',
  '>': '\\u003e',
  '&': '\\u0026',
  '\u2028': '\\u2028',
  '\u2029': '\\u2029'
}[character] ?? character));
---

<CookieBanner
  enabled={enabled}
  id="stage-analytics-consent"
  variant="compact"
  position="bottom-right"
  theme="auto"
  privacyHref="/privacy"
  consentDurationDays={180}
  noticeVersion="consent-v3"
  policyVersion="privacy-v1"
  categories={categories}
  className="stage-consent"
/>

{
  enabled ? (
    <>
      <script is:inline id={preferencesConfigId} type="application/json" set:html={preferencesConfig} />
      <script>
        import { openConsentPreferences } from '@ooopsstudio/analytics-consent';

        const mountPreferences = () => {
          document.querySelectorAll('[data-ooops-consent-preferences]').forEach((button) => {
            if (!(button instanceof HTMLButtonElement) || button.dataset.ooopsConsentPreferencesMounted === 'true') return;
            const config = document.getElementById('stage-analytics-preferences-config');
            if (!config?.textContent) return;
            button.dataset.ooopsConsentPreferencesMounted = 'true';
            button.addEventListener('click', () => openConsentPreferences(JSON.parse(config.textContent)));
          });
        };

        mountPreferences();
        document.addEventListener('astro:page-load', mountPreferences);
      </script>
    </>
  ) : null
}

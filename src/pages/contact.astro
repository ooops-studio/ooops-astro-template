---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Dialog from '../components/ui/Dialog.astro';
import InputField from '../components/ui/InputField.astro';
import Section from '../components/ui/Section.astro';
import TextareaField from '../components/ui/TextareaField.astro';
import {siteUrl} from '../lib/cms/env';

const seo = {
  title: 'Contact | Ooops CMS Astro Site',
  description: 'Contact form powered by the canonical Ooops UI components.',
  canonical: `${siteUrl}/contact`,
  type: 'website' as const
};
---

<BaseLayout {seo}>
  <Section spacing="md" class="contact-page" editorId="contact-section">
    <a href="/" data-astro-prefetch>Back home</a>
    <header class="contact-heading">
      <span class="eyebrow">Contact</span>
      <h1>Tell us what you need</h1>
      <p>Use the form below and we will respond with the next practical step.</p>
    </header>
    <form id="contact-form" class="contact-form">
      <InputField id="contact-name" name="name" label="Name" autocomplete="name" required editorId="contact-name" />
      <InputField id="contact-email" name="email" type="email" label="Email" autocomplete="email" required editorId="contact-email" />
      <TextareaField id="contact-message" name="message" label="Message" rows={3} minRows={3} maxRows={6} autoResize required editorId="contact-message" />
      <div class="contact-actions">
        <Button type="submit" label="Send request" editorId="contact-submit" />
        <Dialog id="contact-privacy" title="Privacy note" triggerLabel="Privacy note" confirmLabel="Understood" cancelLabel="Close" editorId="contact-privacy">
          <p>Only the information needed to respond to this request is collected.</p>
        </Dialog>
      </div>
    </form>
    <output id="contact-result" class="contact-result" aria-live="polite"></output>
  </Section>

  <script>
    import { createCmsPublicFormsClient } from '@ooopsstudio/cms-api'

    type PublicFormNode = { id?: string; apiId?: string }
    type PublicFormSchema = {
      form?: { pages?: Array<{ sections?: Array<{ nodes?: PublicFormNode[] }> }> }
    }

    const publicFormsBaseUrl = (baseUrl: string) => {
      const normalized = baseUrl.replace(/\/+$/, '')
      if (normalized.endsWith('/api/cms/v1')) return `${normalized.slice(0, -11)}/api/cms/public`
      if (normalized.endsWith('/api/cms/public')) return normalized
      return `${normalized}/api/cms/public`
    }

    const loadAnswerIds = async (baseUrl: string, shareToken: string) => {
      const response = await fetch(`${publicFormsBaseUrl(baseUrl)}/forms/${encodeURIComponent(shareToken)}`, {
        headers: { accept: 'application/json' }
      })
      if (!response.ok) throw new Error('Unable to load the public form schema.')
      const payload = await response.json() as PublicFormSchema
      const nodes = payload.form?.pages?.flatMap((page) =>
        page.sections?.flatMap((section) => section.nodes || []) || []
      ) || []
      return new Map(nodes.flatMap((node) =>
        node.apiId && node.id ? [[node.apiId, node.id] as const] : []
      ))
    }

    const installContactForm = () => {
      const form = document.querySelector<HTMLFormElement>('#contact-form')
      const output = document.querySelector<HTMLOutputElement>('#contact-result')
      if (!form || !output || form.dataset.mounted === 'true') return
      form.dataset.mounted = 'true'
      const abort = new AbortController()
      form.addEventListener('submit', async (event) => {
        event.preventDefault()
        if (!form.reportValidity()) return
        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')
        const data = new FormData(form)
        const name = String(data.get('name') || '').trim()
        const email = String(data.get('email') || '').trim()
        const message = String(data.get('message') || '').trim()
        const baseUrl = import.meta.env.PUBLIC_CMS_API_BASE_URL || ''
        const shareToken = import.meta.env.PUBLIC_CONTACT_FORM_TOKEN || ''

        if (!baseUrl || !shareToken) {
          output.value = 'Contact form is temporarily unavailable.'
          return
        }

        button?.setAttribute('disabled', '')
        output.value = 'Sending…'
        try {
          const answerIds = await loadAnswerIds(baseUrl, shareToken)
          const nameId = answerIds.get('name')
          const emailId = answerIds.get('email')
          const messageId = answerIds.get('message')
          if (!nameId || !emailId || !messageId) throw new Error('Required public form fields are missing.')
          const response = await createCmsPublicFormsClient({baseUrl}).forms.submit<{
            submitted?: boolean
            thankYouMessage?: string
          }>(shareToken, {
            answers: {[nameId]: name, [emailId]: email, [messageId]: message},
            submitterIdentity: {name, email},
            metadata: {source: 'ooops-ssg-test-contact'}
          })
          output.value = response.thankYouMessage || 'Thanks. Your message has been received.'
          form.reset()
        } catch {
          output.value = 'We could not send your message. Please try again.'
        } finally {
          button?.removeAttribute('disabled')
        }
      }, {signal: abort.signal})
      document.addEventListener('astro:before-swap', () => abort.abort(), {once: true, signal: abort.signal})
    }
    installContactForm()
    document.addEventListener('astro:page-load', installContactForm)
  </script>
</BaseLayout>

<style>
  .contact-page { display: grid; gap: var(--space-7); max-width: 760px; }
  .contact-heading, .contact-form { display: grid; gap: var(--space-4); }
  .contact-heading :is(h1, p) { margin: 0; }
  .contact-form { padding-block: var(--space-4); }
  .contact-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .contact-result { min-height: 1.5em; overflow-wrap: anywhere; color: var(--color-muted); }
</style>

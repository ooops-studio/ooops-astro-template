{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ooops-ssg-test",
  "account_id": "032d55a9fb124f52d4288ddbd2a547aa",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "test.ooops.studio", "custom_domain": true }],
  "triggers": { "crons": [] },
  "main": "dist/server/entry.mjs",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "assets": { "binding": "ASSETS", "directory": "dist/client" },
  // These are the existing installed resources, not starter allocations.
  "kv_namespaces": [{ "binding": "SESSION", "id": "27d3ca0889954e98b2d1664d03d5da2b" }],
  "durable_objects": {
    "bindings": [{ "name": "CMS_REBUILD_REPLAY_GUARD", "class_name": "CmsRebuildReplayGuard" }]
  },
  // Historical declaration matches the installed migration tag; no new migration.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CmsRebuildReplayGuard"] }],
  "images": { "binding": "IMAGES" },
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "persist": true, "invocation_logs": true },
    "traces": { "enabled": false, "head_sampling_rate": 1, "persist": true }
  }
}
